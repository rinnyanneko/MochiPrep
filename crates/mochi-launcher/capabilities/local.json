{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "The launcher's bundled pages.",
  "windows": ["terms", "settings", "import", "panel"],
  "permissions": [
    "allow-accept-terms",
    "allow-decline-terms",
    "allow-close-terms",
    "allow-get-settings",
    "allow-save-settings",
    "allow-choose-import-folder",
    "allow-run-import",
    "allow-skip-import",
    "allow-panel-state",
    "allow-panel-action",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
