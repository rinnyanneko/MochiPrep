{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MochiPrep",
  "identifier": "io.github.rinnyanneko.mochiprep",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/rinnyanneko/MochiPrep/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRDU5MUFFOUI2RThBMTcKUldRWGltNmJycEhWRUR5WEY3QVZvejFWaWs2N2MycExtVEtXTWh1cEMzMHFFY3VWaW9yZkZQY1UK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "publisher": "rinnyanneko",
    "category": "Finance",
    "shortDescription": "Your cute little AI trading companion",
    "longDescription": "Local-first, BYOK AI trading terminal for USDT-margined crypto perpetuals. Agents trade paper accounts, OKX Demo Trading, or real OKX accounts.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
