{
  "name": "@mochiprep/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --max-semi-space-size=1 --disable-warning=ExperimentalWarning src/main.ts",
    "build": "node build.mjs",
    "start": "node build.mjs && node --max-semi-space-size=1 --enable-source-maps --disable-warning=ExperimentalWarning dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@mochiprep/agents": "workspace:*",
    "@mochiprep/ai-providers": "workspace:*",
    "@mochiprep/core": "workspace:*",
    "@mochiprep/exchanges": "workspace:*",
    "@mochiprep/market-data": "workspace:*",
    "@mochiprep/shared": "workspace:*",
    "fastify": "^5.12.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "^4.23.0"
  }
}
