# MochiPrep needs NO environment variables to run Demo Mode.
# AI keys are never read from here: enter them in Settings. They live in backend memory only.

# Backend port (always bound to 127.0.0.1)
MOCHIPREP_PORT=8787
# Where the SQLite database lives (default: ./.mochiprep at the repo root)
# MOCHIPREP_DATA_DIR=./.mochiprep
# Extra browser origins allowed to talk to the backend (comma separated)
# MOCHIPREP_ALLOWED_ORIGINS=http://localhost:5173
