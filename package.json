{
  "name": "mochiprep",
  "version": "0.1.0",
  "private": true,
  "description": "Your cute little AI trading companion. Local-first, BYOK, paper-trading crypto perpetuals.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=9" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @mochiprep/web build",
    "start": "pnpm build && cargo run --release -p mochi-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cargo build --release -p mochi-server && playwright test",
    "typecheck": "pnpm -r --parallel typecheck",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:web-memory": "node scripts/measure-web-memory.mjs",
    "tauri": "tauri",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
